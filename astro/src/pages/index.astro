---
const title = "Green Lab Attendance";
const description =
  "Astro frontend foundation for the Green Lab attendance system.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body>
    <main>
      <h1>{title}</h1>
      <p>{description}</p>
      <p>
        Astro frontend foundation added. Existing Green Lab pages remain
        unchanged while the UI is migrated incrementally.
      </p>
    </main>
  </body>
</html>
