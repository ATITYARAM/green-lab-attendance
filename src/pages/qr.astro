---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const attendanceUrl = new URL(
  "attendance.html?action=scan",
  new URL(base, Astro.site)
).href;
---

<Layout title="Green Lab | Attendance QR">
  <main class="qr-print-page">
    <section class="qr-mobile-message" aria-live="polite">
      <h1>QR Code Not Available on Mobile</h1>
      <p>The Green Lab attendance QR code is available only on desktop browsers for printing and display.</p>
    </section>
    <section class="qr-print-card">
      <h1>Green Lab</h1>
      <p>Scan this QR code to record Green Lab attendance.</p>

      <img
        class="qr-print-image"
        src={
          "https://quickchart.io/qr?text=" +
          encodeURIComponent(attendanceUrl) +
          "&format=svg&size=500&margin=4&ecLevel=Q"
        }
        alt="Green Lab Attendance QR Code"
      />

      <p class="url">{attendanceUrl}</p>

      <button class="print-button" type="button" onclick="window.print()">
        Print QR Code
      </button>
    </section>
  </main>
</Layout>
